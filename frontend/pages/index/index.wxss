/* pages/index/index.wxss */
.index-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  padding: 60rpx 40rpx 80rpx;
  border-radius: 0 0 60rpx 60rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.greeting {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 快捷功能 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  padding: 0 40rpx;
  margin: -40rpx 0 40rpx;
}

.action-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.1);
  width: 150rpx;
}

.action-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333333;
}

/* 区块 */
.section {
  margin: 40rpx 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 40rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.section-more {
  font-size: 26rpx;
  color: #FF6B9D;
}

/* 宠物列表 */
.pet-scroll {
  white-space: nowrap;
  padding: 0 40rpx;
}

.pet-card-wrapper {
  display: inline-block;
  margin-right: 20rpx;
}

.pet-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  width: 220rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.pet-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  margin-bottom: 20rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
}

.pet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 8rpx;
}

.pet-breed {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.add-pet {
  border: 2rpx dashed #FFB6C1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 280rpx;
}

.add-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
  opacity: 0.5;
}

.add-text {
  font-size: 24rpx;
  color: #FF6B9D;
}

/* 提醒列表 */
.reminders {
  padding: 0 40rpx;
}

.reminder-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.reminder-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.reminder-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
}

.reminder-icon.high {
  background: linear-gradient(135deg, #F38181 0%, #FFB6B9 100%);
}

.reminder-icon.medium {
  background: linear-gradient(135deg, #FCE38A 0%, #F9E79F 100%);
}

.reminder-icon.low {
  background: linear-gradient(135deg, #95E1D3 0%, #B8E8D8 100%);
}

.icon-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.reminder-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.reminder-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 8rpx;
}

.reminder-time {
  font-size: 22rpx;
  color: #999999;
}

.reminder-status {
  padding: 15rpx;
}

.check-icon {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.4;
}

/* 即将到期 */
.upcoming {
  padding: 0 40rpx;
}

.upcoming-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 25rpx;
  margin-bottom: 15rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.upcoming-icon {
  width: 70rpx;
  height: 70rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
}

.upcoming-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.upcoming-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.upcoming-pet {
  font-size: 22rpx;
  color: #999999;
  margin-bottom: 6rpx;
}

.upcoming-date {
  font-size: 22rpx;
  color: #FF6B9D;
}

.upcoming-days {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  border-radius: 30rpx;
  padding: 10rpx 20rpx;
}

.days-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 26rpx;
  color: #CCCCCC;
}
