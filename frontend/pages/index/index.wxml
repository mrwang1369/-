<!--pages/index/index.wxml-->
<view class="index-container">
  <!-- 头部问候 -->
  <view class="header">
    <view class="user-info">
      <text class="greeting">你好，{{userInfo.nickname || '亲爱的'}}~</text>
      <text class="subtitle">今天是爱宠健康守护的一天</text>
    </view>
  </view>

  <!-- 快捷功能卡片 -->
  <view class="quick-actions">
    <view class="action-card" bindtap="navigateToPetAdd">
      <image class="action-icon" src="/images/icons/add-pet.png"></image>
      <text class="action-text">添加宠物</text>
    </view>
    <view class="action-card" bindtap="navigateToHealth">
      <image class="action-icon" src="/images/icons/health.png"></image>
      <text class="action-text">健康记录</text>
    </view>
    <view class="action-card" bindtap="navigateToReminder">
      <image class="action-icon" src="/images/icons/reminder.png"></image>
      <text class="action-text">提醒事项</text>
    </view>
    <view class="action-card" bindtap="navigateToMap">
      <image class="action-icon" src="/images/icons/map.png"></image>
      <text class="action-text">周边服务</text>
    </view>
  </view>

  <!-- 我的宠物 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的宠物</text>
      <text class="section-more" bindtap="navigateToPets">查看全部</text>
    </view>

    <scroll-view class="pet-scroll" scroll-x="{{true}}" show-scrollbar="{{false}}">
      <block wx:if="{{pets.length > 0}}">
        <view class="pet-card-wrapper" wx:for="{{pets}}" wx:key="petId">
          <view class="pet-card" bindtap="navigateToPetDetail" data-id="{{item.petId}}">
            <image class="pet-avatar" src="{{item.avatarUrl || '/images/default-pet.png'}}" mode="aspectFill"></image>
            <text class="pet-name">{{item.name}}</text>
            <text class="pet-breed">{{item.species}} · {{item.breed}}</text>
          </view>
        </view>
      </block>

      <view class="pet-card-wrapper" wx:else bindtap="navigateToPetAdd">
        <view class="pet-card add-pet">
          <image class="add-icon" src="/images/icons/add.png"></image>
          <text class="add-text">添加宠物</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 今日提醒 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">今日提醒</text>
      <text class="section-more" bindtap="navigateToReminder">全部</text>
    </view>

    <view class="reminders">
      <block wx:if="{{todayReminders.length > 0}}">
        <view class="reminder-item" wx:for="{{todayReminders}}" wx:key="reminderId">
          <view class="reminder-content">
            <view class="reminder-icon {{item.priority}}">
              <text class="icon-text">{{item.reminderType[0]}}</text>
            </view>
            <view class="reminder-info">
              <text class="reminder-title">{{item.title}}</text>
              <text class="reminder-time">{{item.dueDate}}</text>
            </view>
          </view>
          <view class="reminder-status" bindtap="completeReminder" data-id="{{item.reminderId}}">
            <image class="check-icon" src="/images/icons/check.png"></image>
          </view>
        </view>
      </block>

      <view class="empty-state" wx:else>
        <image class="empty-icon" src="/images/icons/empty.png"></image>
        <text class="empty-text">今天没有待办提醒</text>
      </view>
    </view>
  </view>

  <!-- 即将到期 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">即将到期</text>
    </view>

    <view class="upcoming">
      <block wx:if="{{upcomingItems.length > 0}}">
        <view class="upcoming-item" wx:for="{{upcomingItems}}" wx:key="id">
          <view class="upcoming-icon {{item.type}}">
            <text class="icon-text">{{item.type[0]}}</text>
          </view>
          <view class="upcoming-info">
            <text class="upcoming-title">{{item.title}}</text>
            <text class="upcoming-pet">{{item.petName}}</text>
            <text class="upcoming-date">{{item.date}}</text>
          </view>
          <view class="upcoming-days">
            <text class="days-text">{{item.days}}天后</text>
          </view>
        </view>
      </block>

      <view class="empty-state" wx:else>
        <text class="empty-text">暂无即将到期项目</text>
      </view>
    </view>
  </view>
</view>
