<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">添加疫苗记录</text>
    <text class="subtitle">记录宝贝的疫苗接种信息</text>
  </view>

  <!-- 表单 -->
  <view class="form">
    <!-- 宠物选择 -->
    <view class="form-item">
      <text class="label">选择宠物</text>
      <picker bindchange="onPetChange" value="{{petIndex}}" range="{{petList}}" range-key="name">
        <view class="picker">
          {{petList[petIndex].name || '请选择宠物'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 疫苗名称 -->
    <view class="form-item">
      <text class="label">疫苗名称</text>
      <input 
        class="input" 
        placeholder="例如: 狂犬疫苗"
        value="{{formData.name}}"
        bindinput="onNameInput"
      />
    </view>

    <!-- 疫苗类型 -->
    <view class="form-item">
      <text class="label">疫苗类型</text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{vaccineTypes}}">
        <view class="picker">
          {{vaccineTypes[typeIndex] || '请选择类型'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 接种日期 -->
    <view class="form-item">
      <text class="label">接种日期</text>
      <picker 
        mode="date" 
        value="{{formData.vaccinateDate}}" 
        bindchange="onDateChange"
        start="{{minDate}}"
        end="{{maxDate}}"
      >
        <view class="picker">
          {{formData.vaccinateDate || '请选择日期'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 接种医院 -->
    <view class="form-item">
      <text class="label">接种医院</text>
      <input 
        class="input" 
        placeholder="例如: 宠物之家医院"
        value="{{formData.hospital}}"
        bindinput="onHospitalInput"
      />
    </view>

    <!-- 医生姓名 -->
    <view class="form-item">
      <text class="label">医生姓名</text>
      <input 
        class="input" 
        placeholder="可选填"
        value="{{formData.doctor}}"
        bindinput="onDoctorInput"
      />
    </view>

    <!-- 疫苗批号 -->
    <view class="form-item">
      <text class="label">疫苗批号</text>
      <input 
        class="input" 
        placeholder="可选填"
        value="{{formData.batchNumber}}"
        bindinput="onBatchInput"
      />
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注信息</text>
      <textarea 
        class="textarea" 
        placeholder="可选填"
        value="{{formData.remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
      <text class="char-count">{{formData.remark.length}}/200</text>
    </view>

    <!-- 上传凭证 -->
    <view class="form-item upload-item">
      <text class="label">上传凭证</text>
      <view class="upload-area">
        <view 
          class="upload-box" 
          wx:if="{{!formData.certificateUrl}}"
          bindtap="chooseImage"
        >
          <text class="upload-icon">+</text>
          <text class="upload-text">点击上传图片</text>
        </view>
        <view class="upload-preview" wx:else>
          <image 
            src="{{formData.certificateUrl}}" 
            class="preview-image"
            mode="aspectFill"
          />
          <text class="delete-btn" bindtap="deleteImage">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn secondary" bindtap="onCancel">取消</button>
    <button class="btn primary" bindtap="onSubmit">保存记录</button>
  </view>
</view>
