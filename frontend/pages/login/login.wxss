/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE4E8 100%);
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
}

/* Logo区域 */
.logo-section {
  padding-top: 120rpx;
  text-align: center;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.app-name {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FF6B9D;
  margin-bottom: 15rpx;
}

.app-slogan {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

/* 登录表单 */
.login-form {
  margin-top: 80rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.input-wrapper {
  background: #FFFFFF;
  border-radius: 50rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  height: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.placeholder {
  color: #CCCCCC;
}

.password-toggle {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

/* 按钮 */
.login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
  margin-top: 60rpx;
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn[disabled] {
  opacity: 0.6;
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 60rpx 0;
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #FFE4E8 50%, transparent 100%);
}

.divider-text {
  padding: 0 30rpx;
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 微信登录按钮 */
.wx-login-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  background: #FFFFFF;
  color: #333333;
  border: 2rpx solid #FFE4E8;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wx-login-btn::after {
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
}

.wx-login-btn:active {
  background: #FFF5F5;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  margin-top: auto;
  padding-bottom: 60rpx;
}

.link {
  font-size: 26rpx;
  color: #FF6B9D;
}
