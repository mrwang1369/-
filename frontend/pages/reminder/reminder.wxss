/* pages/reminder/reminder.wxss */
.reminder-container {
  min-height: 100vh;
  background: #FFF5F5;
  padding-bottom: 220rpx;
}

/* 标签切换 */
.tabs {
  background: #FFFFFF;
  display: flex;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  padding: 25rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active {
  color: #FF6B9D;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  border-radius: 2rpx;
}

.tab-badge {
  position: absolute;
  top: 15rpx;
  right: 15rpx;
  background: linear-gradient(135deg, #F38181 0%, #FFB6B9 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 20rpx;
  min-width: 30rpx;
}

/* 提醒列表 */
.reminder-list {
  padding: 0 20rpx;
}

.reminder-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.reminder-card.completed {
  opacity: 0.6;
}

/* 提醒头部 */
.reminder-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.reminder-type {
  display: flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: linear-gradient(135deg, #FF6B9D15 0%, #FFB6C115 100%);
  color: #FF6B9D;
}

.reminder-type.high {
  background: linear-gradient(135deg, #F3818120 0%, #FFB6B920 100%);
  color: #F38181;
}

.reminder-type.medium {
  background: linear-gradient(135deg, #FCE38A20 0%, #F9E79F20 100%);
  color: #FCE38A;
}

.reminder-type.low {
  background: linear-gradient(135deg, #95E1D320 0%, #B8E8D820 100%);
  color: #95E1D3;
}

.type-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.reminder-status {
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.reminder-status.completed {
  background: linear-gradient(135deg, #95E1D320 0%, #B8E8D820 100%);
  color: #95E1D3;
}

.reminder-status.pending {
  background: linear-gradient(135deg, #FCE38A20 0%, #F9E79F20 100%);
  color: #FCE38A;
}

/* 提醒内容 */
.reminder-body {
  margin-bottom: 20rpx;
}

.reminder-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 10rpx;
}

.reminder-description {
  display: block;
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  margin-bottom: 15rpx;
}

.reminder-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #999999;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

/* 操作按钮 */
.reminder-footer {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx;
  background: #FFEEF3;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #666666;
}

.action-btn:active {
  background: #FFD6DE;
}

.complete-btn {
  background: linear-gradient(135deg, #95E1D315 0%, #B8E8D815 100%);
  color: #95E1D3;
}

.complete-btn.completed {
  background: linear-gradient(135deg, #FF6B9D15 0%, #FFB6C115 100%);
  color: #FF6B9D;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 6rpx;
  opacity: 0.7;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #CCCCCC;
  margin-bottom: 60rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 28rpx;
}

/* 生成健康提醒 */
.generate-section {
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.generate-btn {
  width: 100%;
  height: 90rpx;
  border-radius: 45rpx;
  background: linear-gradient(135deg, #95E1D3 0%, #B8E8D8 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.generate-btn::after {
  border: none;
}

.generate-btn:active {
  transform: scale(0.98);
}

.generate-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

/* 浮动按钮 */
.fab {
  position: fixed;
  bottom: 100rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.4);
  z-index: 100;
}

.fab-icon {
  width: 60rpx;
  height: 60rpx;
}

.fab:active {
  transform: scale(0.95);
}
