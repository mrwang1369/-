/* pages/pet-detail/pet-detail.wxss */
.pet-detail-container {
  min-height: 100vh;
  background: #FFF5F5;
  padding-bottom: 40rpx;
}

/* 头部信息 */
.pet-header {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  align-items: center;
}

.pet-avatar-wrapper {
  position: relative;
  margin-right: 30rpx;
}

.pet-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
}

.edit-avatar {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 50rpx;
  height: 50rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.camera-icon {
  width: 30rpx;
  height: 30rpx;
}

.pet-basic-info {
  flex: 1;
  color: #FFFFFF;
}

.pet-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.pet-name {
  font-size: 40rpx;
  font-weight: 600;
  margin-right: 15rpx;
}

.gender-tag {
  display: flex;
  align-items: center;
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  font-size: 22rpx;
}

.gender-tag.male {
  background: rgba(100, 200, 255, 0.3);
}

.gender-tag.female {
  background: rgba(255, 150, 200, 0.3);
}

.gender-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 6rpx;
}

.pet-breed {
  display: block;
  font-size: 26rpx;
  margin-bottom: 8rpx;
  opacity: 0.9;
}

.pet-age {
  display: block;
  font-size: 24rpx;
  opacity: 0.8;
}

/* 信息区块 */
.info-section {
  background: #FFFFFF;
  margin: -40rpx 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 25rpx;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

/* 快捷操作 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
}

.action-item {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 15rpx;
}

.action-name {
  font-size: 22rpx;
  color: #666666;
  margin-bottom: 8rpx;
}

.action-count {
  font-size: 20rpx;
  color: #FF6B9D;
  font-weight: 600;
}

/* 成长时光轴 */
.growth-section {
  background: #FFFFFF;
  margin: 0 20rpx 20rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.section-more {
  font-size: 24rpx;
  color: #FF6B9D;
}

.timeline-preview {
  max-height: 300rpx;
  overflow: hidden;
}

.timeline-item {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  position: relative;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 14rpx;
  top: 30rpx;
  bottom: -25rpx;
  width: 2rpx;
  background: #FFE4E8;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  margin-right: 20rpx;
  flex-shrink: 0;
}

.timeline-dot.vaccine {
  background: linear-gradient(135deg, #95E1D3 0%, #B8E8D8 100%);
}

.timeline-dot.checkup {
  background: linear-gradient(135deg, #FCE38A 0%, #F9E79F 100%);
}

.timeline-dot.weight {
  background: linear-gradient(135deg, #A8D8EA 0%, #D4E9F7 100%);
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.timeline-title {
  font-size: 26rpx;
  color: #333333;
  margin-bottom: 6rpx;
}

.timeline-date {
  font-size: 22rpx;
  color: #999999;
}

.empty-timeline {
  text-align: center;
  padding: 40rpx 0;
}

.empty-text {
  font-size: 24rpx;
  color: #CCCCCC;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  padding: 0 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  border: none;
}

.btn-outline {
  background: transparent;
  color: #FF6B9D;
  border: 2rpx solid #FF6B9D;
}
