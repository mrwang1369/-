<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="title">添加病历记录</text>
    <text class="subtitle">记录宝贝的就医信息</text>
  </view>

  <!-- 表单 -->
  <view class="form">
    <!-- 宠物选择 -->
    <view class="form-item">
      <text class="label">选择宠物</text>
      <picker bindchange="onPetChange" value="{{petIndex}}" range="{{petList}}" range-key="name">
        <view class="picker">
          {{petList[petIndex].name || '请选择宠物'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 就医日期 -->
    <view class="form-item">
      <text class="label">就医日期</text>
      <picker 
        mode="date" 
        value="{{formData.visitDate}}" 
        bindchange="onDateChange"
        start="{{minDate}}"
        end="{{maxDate}}"
      >
        <view class="picker">
          {{formData.visitDate || '请选择日期'}}
          <text class="arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 就医机构 -->
    <view class="form-item">
      <text class="label">就医机构</text>
      <input 
        class="input" 
        placeholder="例如: 宠物之家医院"
        value="{{formData.institution}}"
        bindinput="onInstitutionInput"
      />
    </view>

    <!-- 医生姓名 -->
    <view class="form-item">
      <text class="label">医生姓名</text>
      <input 
        class="input" 
        placeholder="可选填"
        value="{{formData.doctor}}"
        bindinput="onDoctorInput"
      />
    </view>

    <!-- 主诉 -->
    <view class="form-item">
      <text class="label">主诉</text>
      <textarea 
        class="textarea" 
        placeholder="描述宠物的主要症状"
        value="{{formData.symptoms}}"
        bindinput="onSymptomsInput"
        maxlength="500"
      />
      <text class="char-count">{{formData.symptoms.length}}/500</text>
    </view>

    <!-- 诊断结果 -->
    <view class="form-item">
      <text class="label">诊断结果</text>
      <textarea 
        class="textarea" 
        placeholder="医生的诊断结果"
        value="{{formData.diagnosis}}"
        bindinput="onDiagnosisInput"
        maxlength="500"
      />
      <text class="char-count">{{formData.diagnosis.length}}/500</text>
    </view>

    <!-- 治疗方案 -->
    <view class="form-item">
      <text class="label">治疗方案</text>
      <textarea 
        class="textarea" 
        placeholder="医生给出的治疗方案"
        value="{{formData.treatment}}"
        bindinput="onTreatmentInput"
        maxlength="500"
      />
      <text class="char-count">{{formData.treatment.length}}/500</text>
    </view>

    <!-- 处方信息 -->
    <view class="form-item">
      <text class="label">处方信息</text>
      <textarea 
        class="textarea" 
        placeholder="开具的药品和用法用量"
        value="{{formData.prescription}}"
        bindinput="onPrescriptionInput"
        maxlength="500"
      />
      <text class="char-count">{{formData.prescription.length}}/500</text>
    </view>

    <!-- 费用 -->
    <view class="form-item">
      <text class="label">费用 (元)</text>
      <input 
        class="input" 
        type="digit"
        placeholder="可选填"
        value="{{formData.cost}}"
        bindinput="onCostInput"
      />
    </view>

    <!-- 备注 -->
    <view class="form-item">
      <text class="label">备注信息</text>
      <textarea 
        class="textarea" 
        placeholder="可选填"
        value="{{formData.remark}}"
        bindinput="onRemarkInput"
        maxlength="200"
      />
      <text class="char-count">{{formData.remark.length}}/200</text>
    </view>

    <!-- 上传病历 -->
    <view class="form-item upload-item">
      <text class="label">上传病历</text>
      <view class="upload-area">
        <view 
          class="upload-box" 
          wx:if="{{!formData.medicalRecordUrl}}"
          bindtap="chooseImage"
        >
          <text class="upload-icon">+</text>
          <text class="upload-text">点击上传病历</text>
        </view>
        <view class="upload-preview" wx:else>
          <image 
            src="{{formData.medicalRecordUrl}}" 
            class="preview-image"
            mode="aspectFill"
          />
          <text class="delete-btn" bindtap="deleteImage">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="btn secondary" bindtap="onCancel">取消</button>
    <button class="btn primary" bindtap="onSubmit">保存记录</button>
  </view>
</view>
