/* pages/register/register.wxss */
.register-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF5F5 0%, #FFE4E8 100%);
  padding: 0 60rpx;
  display: flex;
  flex-direction: column;
}

/* 头部 */
.header {
  padding-top: 100rpx;
  margin-bottom: 60rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #FF6B9D;
  margin-bottom: 15rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #999999;
}

/* 注册表单 */
.register-form {
  flex: 1;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-wrapper {
  background: #FFFFFF;
  border-radius: 50rpx;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  height: 100rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.input-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.placeholder {
  color: #CCCCCC;
}

.password-toggle {
  width: 40rpx;
  height: 40rpx;
  opacity: 0.6;
}

/* 用户协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  margin: 40rpx 0 60rpx;
}

.agreement-checkbox {
  margin-top: 4rpx;
  margin-right: 10rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #666666;
  line-height: 1.6;
}

.link {
  color: #FF6B9D;
}

/* 注册按钮 */
.register-btn {
  width: 100%;
  height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.3);
}

.register-btn:active {
  transform: scale(0.98);
}

.register-btn[disabled] {
  opacity: 0.4;
}

/* 底部链接 */
.footer-links {
  text-align: center;
  padding-bottom: 60rpx;
}

.link {
  font-size: 26rpx;
  color: #FF6B9D;
}
