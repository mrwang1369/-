/* pages/map/map.wxss */
.map-container {
  min-height: 100vh;
  background: #FFF5F5;
  padding-bottom: 120rpx;
}

/* 搜索区域 */
.search-section {
  background: #FFFFFF;
  padding: 20rpx;
  margin-bottom: 10rpx;
}

.search-box {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  border-radius: 50rpx;
  padding: 0 20rpx;
  height: 80rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 15rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-btn {
  padding: 10rpx 25rpx;
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  border-radius: 30rpx;
}

/* 筛选区域 */
.filter-section {
  background: #FFFFFF;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.filter-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.filter-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 15rpx 25rpx;
  margin-right: 15rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: #FFEEF3;
  border-color: #FF6B9D;
}

.filter-icon {
  width: 45rpx;
  height: 45rpx;
  margin-bottom: 8rpx;
  opacity: 0.6;
}

.filter-item.active .filter-icon {
  opacity: 1;
}

.filter-item text {
  font-size: 22rpx;
  color: #666666;
}

.filter-item.active text {
  color: #FF6B9D;
  font-weight: 600;
}

/* 服务列表 */
.service-list {
  padding: 0 20rpx;
}

.service-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 157, 0.08);
}

.service-info {
  margin-bottom: 20rpx;
}

/* 服务头部 */
.service-header {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.service-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-right: 15rpx;
}

.service-type-tag {
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF6B9D15 0%, #FFB6C115 100%);
  color: #FF6B9D;
  font-size: 22rpx;
  border-radius: 20rpx;
}

/* 服务地址 */
.service-address {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.address-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  opacity: 0.5;
}

.address-text {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
}

/* 服务元信息 */
.service-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
}

.meta-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

/* 服务操作 */
.service-actions {
  display: flex;
  gap: 15rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 15rpx;
  background: #FFEEF3;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #666666;
}

.action-btn:active {
  background: #FFD6DE;
}

.action-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
  opacity: 0.7;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.3;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #CCCCCC;
  margin-bottom: 60rpx;
}

.refresh-btn {
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  border-radius: 50rpx;
  padding: 20rpx 80rpx;
  font-size: 28rpx;
}

/* 地图按钮 */
.map-btn {
  position: fixed;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FF6B9D 0%, #FFB6C1 100%);
  color: #FFFFFF;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 157, 0.4);
  z-index: 100;
}

.map-btn:active {
  transform: translateX(-50%) scale(0.95);
}

.map-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}

.map-btn text {
  font-size: 28rpx;
  font-weight: 600;
}
